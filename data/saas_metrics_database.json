  "financial_metrics": {
    "gross_margin": {
      "definition": "Revenue minus cost of goods sold (hosting, support, onboarding) divided by revenue",
      "formula": "(Revenue - COGS) / Revenue * 100",
      "benchmarks": {
        "subscription_only": {"median": 78, "top_quartile": 85, "bottom_quartile": 70, "unit": "percent"},
        "total_including_services": {"median": 72, "top_quartile": 78, "bottom_quartile": 65, "unit": "percent"},
        "minimum_for_saas": 70,
        "target": 75,
        "best_in_class": 85,
        "unit": "percent"
      },
      "source": "KeyBanc 2024, Benchmarkit 2025, a16z SaaS guidelines"
    },
    "rule_of_40": {
      "definition": "Growth rate + profit margin should exceed 40% for a healthy SaaS business",
      "formula": "YoY_Revenue_Growth_Pct + EBITDA_Margin_Pct",
      "benchmarks": {
        "median_score_q1_2025": 12,
        "median_growth_component": 10,
        "median_margin_component": 6,
        "target_minimum": 40,
        "excellent": 60,
        "pct_companies_achieving": {"range": "11-30", "unit": "percent"},
        "valuation_premium_for_achieving": "121% valuation premium",
        "revenue_multiple_for_achievers": 10.7,
        "by_stage": {
          "seed": {"typical_score": -30, "note": "Heavy investment, negative margins expected"},
          "series_a": {"typical_score": -10, "note": "Growth dominant, margins improving"},
          "growth": {"typical_score": 20, "note": "Approaching but often below 40"},
          "scale": {"typical_score": 35, "note": "Best companies exceed 40"}
        }
      },
      "source": "SaaS Capital 2025, The SaaS CFO 2025, Abacum Rule of 40 2026"
    },
    "burn_multiple": {
      "definition": "How much cash burned to generate each dollar of net new ARR",
      "formula": "Net_Burn / Net_New_ARR",
      "benchmarks": {
        "by_stage": {
          "seed": {"median": 3.4, "top_quartile": 2.0, "bottom_quartile": 6.0},
          "series_a": {"median": 2.5, "top_quartile": 1.8, "bottom_quartile": 4.5},
          "series_b": {"median": 2.0, "top_quartile": 1.5, "bottom_quartile": 3.5},
          "growth_25m_50m": {"median": 1.4, "top_quartile": 1.0, "bottom_quartile": 2.5}
        },
        "amazing": {"value": "<1.0"},
        "good": {"value": "1.0-1.5"},
        "mediocre": {"value": "1.5-2.0"},
        "concerning": {"value": "2.0-3.0"},
        "bad": {"value": ">3.0"}
      },
      "source": "David Sacks, Craft Ventures; Benchmarkit 2025; CFO Advisors 2025"
    },
    "magic_number": {
      "definition": "Sales efficiency — net new ARR generated per dollar of sales & marketing spend",
      "formula": "(Current_Quarter_ARR - Previous_Quarter_ARR) / Previous_Quarter_Sales_Marketing_Spend",
      "benchmarks": {
        "excellent": {"value": 1.5, "label": "Invest more aggressively"},
        "good": {"value": 1.0, "label": "Efficient, keep investing"},
        "mediocre": {"value": 0.75, "label": "Acceptable but optimize"},
        "poor": {"value": 0.5, "label": "Pull back and fix efficiency"},
        "median": 0.75,
        "top_quartile": 1.2,
        "bottom_quartile": 0.4
      },
      "source": "Scale Venture Partners, Benchmarkit 2025 [EST for quartiles]"
    },
    "months_of_runway": {
      "definition": "Months of operation remaining at current burn rate",
      "formula": "Cash_Balance / Monthly_Net_Burn",
      "benchmarks": {
        "by_stage": {
          "seed": {"target": 18, "range": "12-18", "unit": "months"},
          "series_a": {"target": 24, "range": "18-24", "unit": "months"},
          "series_b": {"target": 24, "range": "18-30", "unit": "months"},
          "growth": {"target": 30, "range": "24-36", "unit": "months"}
        },
        "investor_expectation_2025": "24-30 months minimum",
        "danger_zone": "under 6 months",
        "fundraising_trigger": "under 12 months"
      },
      "monthly_burn_by_stage": {
        "seed": {"median": 80000, "range": "50000-150000", "unit": "USD"},
        "series_a": {"median": 300000, "range": "200000-500000", "unit": "USD"},
        "series_b": {"median": 700000, "range": "400000-1000000", "unit": "USD"},
        "growth": {"median": 1500000, "range": "1000000-3000000", "unit": "USD"}
      },
      "source": "Lighter Capital 2025, Phoenix Strategy Group 2025, ICanPitch 2025"
    },
    "cac_ratio": {
      "definition": "Sales efficiency — inverse of magic number, often expressed as quarterly spend to ARR ratio",
      "formula": "Sales_Marketing_Spend / Net_New_ARR",
      "benchmarks": {
        "efficient": {"value": 1.0, "label": "Spend $1 to get $1 new ARR"},
        "target": {"value": 1.2, "label": "Spend $1.20 to get $1 new ARR"},
        "concerning": {"value": 2.0, "label": "Spend $2 to get $1 new ARR"}
      },
      "source": "Bessemer Cloud Atlas, Scale Venture Partners"
    }
  },

