  "acquisition_metrics": {
    "cac_by_channel": {
      "definition": "Customer Acquisition Cost segmented by marketing/sales channel",
      "formula": "Total_Channel_Spend / Customers_Acquired_Via_Channel",
      "benchmarks": {
        "organic_seo": {"median": 480, "range": "290-942", "unit": "USD"},
        "content_marketing": {"median": 480, "unit": "USD"},
        "paid_search_ppc": {"median": 802, "range": "500-1200", "unit": "USD"},
        "paid_social": {"median": 937, "range": "600-2000", "unit": "USD"},
        "linkedin_ads": {"median": 2000, "range": "1500-3000", "unit": "USD"},
        "referral_programs": {"median": 150, "range": "100-300", "unit": "USD"},
        "email_marketing": {"median": 53, "unit": "USD"},
        "outbound_sales": {"median": 1980, "range": "800-4000", "unit": "USD"},
        "events_conferences": {"median": 500, "range": "300-1500", "unit": "USD"},
        "inbound_blended": {"median": 200, "unit": "USD"},
        "partner_channel": {"median": 150, "unit": "USD"}
      },
      "trend": "CAC surged 40-60% between 2023-2025",
      "source": "First Page Sage 2026, Phoenix Strategy Group 2025, Optifai CAC by Channel"
    },
    "cac_payback_period": {
      "definition": "Months required to recover the cost of acquiring a customer",
      "formula": "CAC / (ARPU * Gross_Margin)",
      "benchmarks": {
        "by_stage": {
          "early_under_1m_arr": {"median": 2, "unit": "months"},
          "seed_1m_5m": {"median": 8, "top_quartile": 5, "bottom_quartile": 14, "unit": "months"},
          "series_a_5m_15m": {"median": 14, "top_quartile": 8, "bottom_quartile": 22, "unit": "months"},
          "growth_15m_50m": {"median": 18, "top_quartile": 12, "bottom_quartile": 28, "unit": "months"},
          "scale_50m_plus": {"median": 20, "top_quartile": 14, "bottom_quartile": 30, "unit": "months"}
