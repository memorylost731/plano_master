        "mid_market": {"median": 1.5, "top_quartile": 0.8, "bottom_quartile": 3.0, "unit": "percent"},
        "enterprise": {"median": 0.5, "top_quartile": 0.2, "bottom_quartile": 1.5, "unit": "percent"}
      },
      "annual": {
        "smb": {"median": 31, "top_quartile": 20, "bottom_quartile": 45, "unit": "percent"},
        "mid_market": {"median": 11, "top_quartile": 7, "bottom_quartile": 20, "unit": "percent"},
        "enterprise": {"median": 6, "top_quartile": 3, "bottom_quartile": 10, "unit": "percent"}
      },
