{
  "_metadata": {
    "version": "1.0.0",
    "created": "2026-04-05",
    "description": "Comprehensive SaaS business metrics database for PlanO simulator calibration",
    "sources": [
      "Bessemer Venture Partners Cloud Atlas (bvp.com/atlas)",
      "OpenView SaaS Benchmarks (openviewpartners.com)",
      "David Skok - SaaS Metrics 2.0 (forentrepreneurs.com)",
      "SaaS Capital Benchmarking Reports 2025",
      "Benchmarkit 2025 SaaS Performance Metrics",
      "High Alpha 2025 SaaS Benchmarks Report",
      "ChartMogul SaaS Retention Reports 2024-2025",
      "KeyBanc Capital Markets SaaS Survey 2024",
      "Lighter Capital 2025 B2B SaaS Startup Benchmarks",
      "First Page Sage SaaS Benchmarks 2025-2026",
      "Optifai B2B SaaS Benchmark Database (939 companies)",
      "Aventis Advisors SaaS Valuation Multiples 2025",
      "Finro PropTech Valuation Multiples 2025",
      "Phoenix Strategy Group CAC Benchmarks 2025",
      "Maxio 2025 SaaS Benchmarks Report",
      "McKinsey TMT SaaS Insights",
      "Paddle/ProfitWell SaaS Index"
    ],
    "notes": "All numbers sourced from 2024-2026 industry reports. Where exact data unavailable, estimates are marked [EST]. Benchmarks represent B2B SaaS unless noted."
  },

  "revenue_metrics": {
    "mrr": {
      "definition": "Monthly Recurring Revenue — predictable revenue normalized to a monthly amount",
      "formula": "SUM(monthly_subscription_fees) for all active customers",
      "benchmarks": {
        "pre_revenue": 0,
        "seed": {"median": 15000, "top_quartile": 50000, "bottom_quartile": 3000, "unit": "USD"},
        "series_a": {"median": 150000, "top_quartile": 350000, "bottom_quartile": 60000, "unit": "USD"},
        "growth": {"median": 800000, "top_quartile": 2000000, "bottom_quartile": 350000, "unit": "USD"},
        "scale": {"median": 5000000, "top_quartile": 15000000, "bottom_quartile": 2000000, "unit": "USD"}
      },
      "source": "ChartMogul SaaS Growth Report 2025, Lighter Capital 2025 Benchmarks"
    },
    "arr": {
      "definition": "Annual Recurring Revenue — annualized value of recurring subscription revenue",
      "formula": "MRR * 12",
      "benchmarks": {
        "seed": {"median": 180000, "top_quartile": 600000, "bottom_quartile": 36000, "unit": "USD"},
        "series_a": {"median": 1800000, "top_quartile": 4200000, "bottom_quartile": 720000, "unit": "USD"},
        "growth": {"median": 10000000, "top_quartile": 25000000, "bottom_quartile": 4000000, "unit": "USD"},
        "scale": {"median": 60000000, "top_quartile": 180000000, "bottom_quartile": 25000000, "unit": "USD"}
      },
      "source": "High Alpha 2025 SaaS Benchmarks, Benchmarkit 2025"
    },
    "cmrr": {
      "definition": "Committed Monthly Recurring Revenue — MRR plus signed contracts not yet live, minus known future churns",
      "formula": "Current_MRR + Signed_Not_Live_MRR - Known_Future_Churn_MRR",
      "benchmarks": {
        "note": "Typically 5-15% higher than MRR for healthy pipeline companies",
        "seed": {"cmrr_to_mrr_ratio": 1.05},
        "series_a": {"cmrr_to_mrr_ratio": 1.10},
        "growth": {"cmrr_to_mrr_ratio": 1.12},
        "scale": {"cmrr_to_mrr_ratio": 1.08}
      },
      "source": "David Skok SaaS Metrics 2.0 [EST based on pipeline ratios]"
    },
    "net_new_mrr": {
      "definition": "Change in MRR from all sources in a given period",
      "formula": "New_MRR + Expansion_MRR - Contraction_MRR - Churned_MRR",
      "benchmarks": {
        "seed": {"median_monthly_pct_of_mrr": 15, "top_quartile": 25, "bottom_quartile": 5, "unit": "percent"},
        "series_a": {"median_monthly_pct_of_mrr": 8, "top_quartile": 15, "bottom_quartile": 3, "unit": "percent"},
        "growth": {"median_monthly_pct_of_mrr": 4, "top_quartile": 8, "bottom_quartile": 1.5, "unit": "percent"},
        "scale": {"median_monthly_pct_of_mrr": 2, "top_quartile": 4, "bottom_quartile": 0.5, "unit": "percent"}
      },
      "source": "Benchmarkit 2025, ChartMogul 2025 [EST for stage breakdown]"
    },
    "arpu": {
      "definition": "Average Revenue Per User/Account — mean revenue generated per customer",
      "formula": "Total_MRR / Total_Active_Customers",
      "benchmarks": {
        "smb": {"median": 50, "top_quartile": 150, "bottom_quartile": 20, "unit": "USD/month"},
        "mid_market": {"median": 500, "top_quartile": 2000, "bottom_quartile": 150, "unit": "USD/month"},
        "enterprise": {"median": 5000, "top_quartile": 25000, "bottom_quartile": 2000, "unit": "USD/month"}
      },
      "median_acv_2024": 62000,
      "source": "KeyBanc 2024 SaaS Survey (median ACV $62K), Optifai 939-company database"
    },
    "revenue_per_employee": {
      "definition": "ARR divided by total full-time equivalent headcount",
      "formula": "ARR / Total_FTE",
      "benchmarks": {
        "by_arr_band": {
          "1m_3m": {"median": 99858, "unit": "USD"},
          "3m_10m": {"median": 120000, "unit": "USD"},
          "10m_25m": {"median": 155000, "unit": "USD"},
          "25m_50m": {"median": 190000, "unit": "USD"},
          "50m_100m": {"median": 240000, "unit": "USD"},
          "100m_plus": {"median": 283379, "unit": "USD"}
        },
        "overall_median": 129724,
        "overall_top_quartile": 200000,
        "overall_bottom_quartile": 85000
      },
      "source": "SaaS Capital 2025 Revenue Per Employee Benchmarks"
    },
    "ndr_nrr": {
      "definition": "Net Dollar Retention / Net Revenue Retention — revenue retained from existing customers including expansion, contraction, and churn",
      "formula": "(Beginning_MRR + Expansion - Contraction - Churn) / Beginning_MRR * 100",
      "benchmarks": {
        "by_segment": {
          "smb_acv_under_25k": {"median": 97, "top_quartile": 105, "bottom_quartile": 90, "unit": "percent"},
          "mid_market_25k_100k": {"median": 108, "top_quartile": 118, "bottom_quartile": 98, "unit": "percent"},
          "enterprise_acv_over_100k": {"median": 118, "top_quartile": 130, "bottom_quartile": 105, "unit": "percent"}
        },
        "by_arr_band": {
          "1m_10m": {"median": 98, "top_quartile": 110, "unit": "percent"},
          "10m_50m": {"median": 104, "top_quartile": 115, "unit": "percent"},
          "50m_100m": {"median": 110, "top_quartile": 120, "unit": "percent"},
          "100m_plus": {"median": 115, "top_quartile": 130, "unit": "percent"}
        },
        "by_acv": {
          "25k_50k": {"median": 102, "top_quartile": 111, "bottom_quartile": 97, "unit": "percent"}
        },
        "overall_median": 106,
        "overall_top_quartile": 120,
        "overall_bottom_quartile": 95,
        "public_saas_median_2024": 110,
        "bootstrapped_3m_20m_median": 104,
        "bootstrapped_90th_percentile": 118
      },
      "pct_companies_above_100": 50,
      "pct_companies_above_100_at_15m_30m_arr": 35.1,
      "source": "SaaS Capital 2025, Optifai 939-company DB, Benchmarkit 2025, ChartMogul Retention Report"
    },
    "gdr": {
      "definition": "Gross Dollar Retention — revenue retained from existing customers excluding expansion (churn + contraction only)",
      "formula": "(Beginning_MRR - Contraction - Churn) / Beginning_MRR * 100",
      "benchmarks": {
        "by_arr_band": {
          "1m_10m": {"median": 85, "unit": "percent"},
          "10m_50m": {"median": 90, "unit": "percent"},
          "50m_100m": {"median": 92, "unit": "percent"},
          "100m_plus": {"median": 94, "unit": "percent"}
        },
        "overall_median": 90,
        "overall_top_quartile": 95,
        "overall_bottom_quartile": 80
      },
      "source": "SaaS Capital 2025, Benchmarkit 2025"
    },
    "quick_ratio": {
      "definition": "Measures growth efficiency — ratio of revenue added vs revenue lost (coined by Mamoon Hamid)",
      "formula": "(New_MRR + Expansion_MRR) / (Churned_MRR + Contraction_MRR)",
      "benchmarks": {
        "excellent": {"value": 4.0, "label": "4:1 or higher — scaling efficiently"},
        "good": {"value": 2.0, "label": "2:1 to 4:1 — healthy but room for improvement"},
        "concerning": {"value": 1.0, "label": "1:1 to 2:1 — unsustainable growth"},
        "critical": {"value": 0.5, "label": "below 1:1 — shrinking"}
      },
      "fastest_growing_saas_average": 3.9,
      "target_minimum": 4.0,
      "source": "Mamoon Hamid (Social Capital), InsightSquared analysis of fastest-growing SaaS"
    },
    "expansion_revenue_pct": {
      "definition": "Percentage of total new ARR coming from existing customer expansion",
      "formula": "Expansion_ARR / Total_New_ARR * 100",
      "benchmarks": {
        "by_arr_band": {
          "under_5m": {"median": 20, "unit": "percent"},
          "5m_25m": {"median": 30, "unit": "percent"},
          "25m_50m": {"median": 40, "unit": "percent"},
          "50m_plus": {"median": 60, "unit": "percent"}
        },
        "overall_median": 40,
        "overall_top_quartile": 55,
        "overall_bottom_quartile": 20,
        "trend_2024": "Increased 5% YoY, reflecting shift to land-and-expand"
      },
      "source": "Benchmarkit 2025, High Alpha 2025 SaaS Benchmarks"
    },
    "contraction_revenue_pct": {
      "definition": "Percentage of beginning-period MRR lost to downgrades (not cancellations)",
      "formula": "Contraction_MRR / Beginning_MRR * 100",
      "benchmarks": {
        "monthly": {"median": 0.5, "top_quartile": 0.2, "bottom_quartile": 1.5, "unit": "percent"},
        "annual": {"median": 5, "top_quartile": 2, "bottom_quartile": 12, "unit": "percent"}
      },
      "source": "ChartMogul SaaS Retention Report [EST]"
    }
  },

  "growth_metrics": {
    "mrr_growth_rate_by_stage": {
      "definition": "Month-over-month MRR growth rate, benchmarked by current MRR band",
      "formula": "(Current_MRR - Previous_MRR) / Previous_MRR * 100",
      "benchmarks": {
        "0_10k_mrr": {"good_mom": 20, "great_mom": 40, "unit": "percent_monthly"},
        "10k_100k_mrr": {"good_mom": 10, "great_mom": 20, "unit": "percent_monthly"},
        "100k_1m_mrr": {"good_mom": 5, "great_mom": 10, "unit": "percent_monthly"},
        "1m_plus_mrr": {"good_mom": 3, "great_mom": 5, "unit": "percent_monthly"}
      },
      "source": "ChartMogul SaaS Growth Report 2025, Lighter Capital 2025"
    },
    "yoy_growth_by_arr_band": {
      "definition": "Year-over-year ARR growth rate by current ARR level",
      "formula": "(Current_ARR - Prior_Year_ARR) / Prior_Year_ARR * 100",
      "benchmarks": {
        "under_1m": {"median": 100, "top_quartile": 200, "bottom_quartile": 40, "unit": "percent"},
        "1m_5m": {"median": 60, "top_quartile": 120, "bottom_quartile": 25, "unit": "percent"},
        "5m_10m": {"median": 45, "top_quartile": 80, "bottom_quartile": 20, "unit": "percent"},
        "10m_25m": {"median": 35, "top_quartile": 65, "bottom_quartile": 15, "unit": "percent"},
        "25m_50m": {"median": 28, "top_quartile": 50, "bottom_quartile": 12, "unit": "percent"},
        "50m_100m": {"median": 25, "top_quartile": 40, "bottom_quartile": 10, "unit": "percent"},
        "100m_plus": {"median": 20, "top_quartile": 35, "bottom_quartile": 8, "unit": "percent"}
      },
      "overall_median_2025": 28,
      "overall_top_quartile_2025": 65,
      "overall_median_2024": 47,
      "ai_native_median_2025": 100,
      "traditional_saas_median_2025": 23,
      "source": "Benchmarkit 2025, High Alpha 2025, ChartMogul 2025"
    },
    "t2d3_trajectory": {
      "definition": "Triple-Triple-Double-Double-Double — the gold-standard VC growth trajectory from ~$2M to $144M ARR",
      "formula": "Year1: ARR*3, Year2: ARR*3, Year3: ARR*2, Year4: ARR*2, Year5: ARR*2",
      "trajectory_example": {
        "year_0": {"arr": 2000000, "label": "Starting point"},
        "year_1": {"arr": 6000000, "label": "Triple (3x)"},
        "year_2": {"arr": 18000000, "label": "Triple (3x)"},
        "year_3": {"arr": 36000000, "label": "Double (2x)"},
        "year_4": {"arr": 72000000, "label": "Double (2x)"},
        "year_5": {"arr": 144000000, "label": "Double (2x)"}
      },
      "required_mom_growth_for_3x": 11.6,
      "pct_companies_achieving": 1,
      "note": "Fewer than 1% of SaaS companies achieve full T2D3. AI-native companies are 4.3x more likely to hit tripling targets.",
      "source": "T2D3.pro, Neeraj Agrawal (Battery Ventures), High Alpha 2025"
    },
    "time_to_1m_arr": {
      "definition": "Months from founding to reaching $1M ARR milestone",
      "benchmarks": {
        "top_10_pct": {"months": 9, "label": "Elite"},
        "top_quartile": {"months": 18, "label": "Strong"},
        "median": {"months": 33, "label": "2 years 9 months"},
        "bottom_quartile": {"months": 54, "label": "4.5 years"}
      },
      "source": "ChartMogul SaaS Growth Report 2025, Lighter Capital 2025"
    },
    "time_to_10m_arr": {
      "definition": "Years from founding to reaching $10M ARR milestone",
      "benchmarks": {
        "top_10_pct": {"years": 2.75, "label": "Under 3 years"},
        "median": {"years": 5.5, "label": "5-6 years"},
        "bottom_quartile": {"years": 8, "label": "7-9 years"}
      },
      "pct_reaching_within_10_years": 13,
      "source": "ChartMogul 2025 SaaS Growth: The Odds of Making It"
    },
    "enduring_growth_rate": {
      "definition": "The rate at which a company's growth rate is retained year-over-year (growth deceleration)",
      "formula": "Current_Year_Growth / Prior_Year_Growth * 100",
      "benchmarks": {
        "historical_benchmark": 80,
        "current_2025_benchmark": 65,
        "top_quartile": 85,
        "bottom_quartile": 45,
        "unit": "percent"
      },
      "note": "Growth endurance has declined from 80% to 65% over 2023-2025 as market matures",
      "source": "Benchmarkit 2025, SaaS Capital 2025"
    }
  },

  "retention_churn": {
